# Copy to .env.local and fill in.

# Public URL of the site (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://example.com

# SQL Server (PortfolioDb). Any ODBC connection string works.
# Local server with Windows authentication over shared memory:
MSSQL_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=lpc:(local);Database=PortfolioDb;Trusted_Connection=Yes;
# SQL login over TCP instead:
# MSSQL_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=myserver,1433;Database=PortfolioDb;Uid=portfolio;Pwd=change-me;Encrypt=yes;TrustServerCertificate=yes;

# Signs admin session cookies. Required in production: 32+ random characters.
ADMIN_SESSION_SECRET=

# Where admin uploads are stored (default: ./storage/media). Must be persistent and writable.
# MEDIA_DIR=D:\portfolio-media

# Optional: also email contact messages via Resend (https://resend.com).
# Messages are always saved to the admin inbox.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
