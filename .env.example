# On Vercel these are set in Project → Settings → Environment Variables.
# Locally, run `vercel env pull .env.local` to copy them.

# Public URL of the site (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://prof-khaled-portfolio.vercel.app

# Postgres connection string (set automatically by the Vercel Neon integration).
DATABASE_URL=

# Vercel Blob token for admin uploads (set automatically when a Blob store is connected).
BLOB_READ_WRITE_TOKEN=

# Signs admin session cookies. Required in production: 32+ random characters.
ADMIN_SESSION_SECRET=

# Optional: also email contact messages via Resend (https://resend.com).
# Messages are always saved to the admin inbox.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
